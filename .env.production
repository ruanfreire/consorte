# Build de demonstração (sem secrets): mensagens em sessionStorage, não no Supabase.
# Para produção com Supabase: crie .env.production.local (gitignored) com VITE_USE_MOCK=false
# e as chaves, ou use apenas o workflow GitHub Actions (VITE_USE_MOCK=false no CI).

VITE_USE_MOCK=true

# GitHub Pages — sem barra final (og:url / og:image no build)
VITE_PUBLIC_SITE_URL=https://ruanfreire.github.io

# Data no passado = história disponível logo após o build (sem contagem regressiva)
VITE_LAUNCH_AT=2020-01-01T00:00:00-03:00

# Opcional em build real (ignorado quando VITE_USE_MOCK=true)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
