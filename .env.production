# Build de produção (Supabase + countdown). Não use mock aqui — o site em produção deve refletir isto
# ou os secrets do GitHub Actions (ver env.example.txt).

VITE_USE_MOCK=false

# GitHub Pages — sem barra final (og:url / og:image no build)
VITE_PUBLIC_SITE_URL=https://ruanfreire.github.io

# Contagem regressiva: defina em GitHub → Settings → Secrets → Actions (VITE_LAUNCH_AT)
# ou crie .env.production.local (gitignored) com a data ISO, ex.:
# VITE_LAUNCH_AT=2026-04-15T19:00:00-03:00

# Supabase: em CI vêm dos secrets; localmente use .env.production.local
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
