# Opcional: mesmo diretório que messages.php e config.php (Apache / compatível com muitos hosts).
# CORS: definido em messages.php.

# Bloquear pedido HTTP direto a config.php (include/require pelo PHP continua a funcionar).
<IfModule mod_authz_core.c>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "config.php">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

# Se o site passar a dar erro 500 após subir este ficheiro, apague-o ou remova só o bloco acima.
